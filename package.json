{
	"name": "dive-map",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@11.17.0",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@maplibre/maplibre-gl-style-spec": "^26.4.2",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@types/fontkit": "^2.0.9",
		"@types/node": "^24",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"flag-icons": "^7.5.0",
		"globals": "^17.6.0",
		"playwright": "^1.63.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"svgo": "^4.1.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.8"
	},
	"description": "Scuba diving map of the Catalan coast: ICGC bathymetry and marine habitats over OSM, printable as A3 dive briefing cards.",
	"dependencies": {
		"@cantoo/pdf-lib": "^2.11.0",
		"fontkit": "^2.0.4",
		"maplibre-gl": "^6.9.0",
		"pmtiles": "^4.5.0",
		"terra-draw": "^1.33.0",
		"terra-draw-maplibre-gl-adapter": "^1.4.1"
	},
	"license": "MIT"
}
